include README.md
include CHANGELOG.md
include LICENSE.txt
include pyproject.toml
recursive-include src/power_rail_validation *.py *.json *.csv
recursive-include docs *.md
recursive-include examples *.json *.md
recursive-include scenarios *.json
recursive-include tests *.py *.json *.lib *.md *.txt
exclude tests/test_d5_finalizer.py
prune build
prune dist
prune tmp
global-exclude __pycache__ *.py[cod]
